# Sprint 24 Phase D — re-run sampling config for the SBFB coordinator.
#
# Copy to `~/.sbfb/rerun_sampling.toml` (per-user dotdir). The
# coordinator reads this file at startup.
#
# Schema:
#   rerun_sample_rate : float, optional (default 0.01). Fraction of
#                       completed tasks randomly selected for
#                       re-dispatch to a second worker. Range 0.0–1.0.
#                       Values outside this range are clamped with a
#                       warning.
#
# Statistical note: 1% on 100 tasks/day = 1 re-run/day. Detection
# latency ~1 day for a systematically divergent worker. Increase to
# 0.05 (5%) for higher-trust environments where compute cost is
# acceptable.
#
# Threat model coverage (HARDENING_ROADMAP §3 S24, C-ComputeTheft):
#   - A worker returning fake results (precomputed cache, model
#     substitution) is detected when the re-run result hash diverges
#     from the original. Mismatch → structured log + quarantine of
#     the divergent worker.

rerun_sample_rate = 0.01
