# Sprint 21 phase coord-side — PII redaction policy sample for the
# SBFB coordinator.
#
# Copy to `~/.sbfb/pii_redaction_policy.toml` (per-user dotdir). The
# coordinator process reads this file lazily on first `redact()` and
# hot-reloads on mtime change (50 ms debounce). Pattern identique au
# `pow_policy_loader.rs` S20 phase coord + `rate_limit_policy_loader`
# phase A.
#
# Le PiiRedactor applique le redact sur `req.prompt` et
# `req.system_prompt` AVANT `nexus_core.sign_task` — le TaskEntry
# signé qui part sur iroh-docs ne contient jamais de PII brutes,
# même si la couche iframe client (phase B `d5b0035`) n'a pas
# tourné.
#
# Schema:
#   [default]
#       confidence_threshold : f64, optional (default 0.5). Score
#                              minimum pour retenir une détection
#                              Presidio/GLiNER. Plus bas = plus
#                              strict (redact plus).
#       enabled_entities     : list[str], optional. Sous-ensemble
#                              des entités à redacter. Default =
#                              EMAIL_ADDRESS, PHONE_NUMBER,
#                              CREDIT_CARD, IBAN_CODE, US_SSN,
#                              IP_ADDRESS, URL, PERSON, LOCATION.
#       redaction_format     : str, optional (default
#                              "<{entity_type}_{N}>"). Placeholder
#                              template. N = index d'apparition
#                              dans le texte (1-based, par type).
#
# Threat model coverage (HARDENING_ROADMAP §3 S21, D2 layer 2):
#   - T4-ModelExtract : worker malveillant extrait PII du prompt
#     user → mitigé par redact coord-side avant wire signing (le
#     worker voit déjà des placeholders `<EMAIL_1>` / `<PERSON_2>`).
#   - T2-PIILeakPassive : user push PII par accident → redact
#     coord-side = defense-in-depth si couche iframe layer 1 a
#     raté (model load fail, client non-browser).
#
# Pivot note : GLiNER model `knowledgator/gliner-pii-edge-v1.0` est
# chargé best-effort. Si absent (pas de modèle HF cache local, pas
# d'internet, import error), le PiiRedactor degrade vers les regex
# built-in Python pur (email/phone/CC/IBAN/SSN/IP/URL) et log
# `pii_redactor_gliner_unavailable`. Le coord boot toujours.

[default]
confidence_threshold = 0.5
enabled_entities = [
    "EMAIL_ADDRESS",
    "PHONE_NUMBER",
    "CREDIT_CARD",
    "IBAN_CODE",
    "US_SSN",
    "IP_ADDRESS",
    "URL",
    "PERSON",
    "LOCATION",
]
redaction_format = "<{entity_type}_{N}>"

# Exemple override pour apps Gate 2 (strict mode — threshold plus
# bas = redact plus large). Uncomment et adapter le nom d'override
# à ton déploiement si besoin.
#
# [overrides.gate2_apps]
# confidence_threshold = 0.3
