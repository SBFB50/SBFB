# Sprint 21 phase coord-side — output filter policy sample for the
# SBFB coordinator.
#
# Copy to `~/.sbfb/output_filter_policy.toml` (per-user dotdir). Le
# coordinator lit ce fichier lazy et hot-reload sur mtime change
# (50 ms debounce, malformed-reload guard, file-deletion guard).
#
# L'OutputFilter est appelé dans `Validator._handle_result` APRÈS
# `Verifier.verify_entries` (3-layer signature + model digest +
# logprob) et AVANT `Dispatcher.mark_completed` + `KudosLedger.
# credit`. Un verdict négatif bloque la delivery au client via
# l'API control plane et décrédite le worker (pattern identique
# à un 3-layer verify fail).
#
# Schema:
#   [default]
#       enabled                   : bool, default true. Master off
#                                   switch (no-op si false).
#
#   [invisible_text]
#       strip_zero_width          : bool, default true. Strip U+200B,
#                                   U+200C, U+200D, U+200E, U+200F,
#                                   U+2060, U+FEFF (BOM).
#       strip_pua                 : bool, default true. Strip Private
#                                   Use Area U+E000-U+F8FF + Plane 15
#                                   + Plane 16.
#       strip_tag_chars           : bool, default true. Strip
#                                   U+E0020-U+E007F (ASCII tag block,
#                                   steganography vector rez0 CCS'24).
#       whitelist_cf              : bool, default true. Garde les
#                                   directional format chars U+202A-
#                                   U+202E et U+2066-U+2069 (bidi
#                                   Arabe/Hébreu i18n légitime).
#
#   [prompt_echo]
#       exact_match               : bool, default true. Block si le
#                                   `system_prompt` est substring
#                                   exact de `model_output`.
#       substring_match_min_len   : int, default 40. Longueur min
#                                   d'une tranche contiguë du
#                                   system_prompt dont la présence
#                                   dans model_output bloque.
#       eed_threshold             : f64, default 0.85. Seuil
#                                   rapidfuzz Levenshtein
#                                   normalized_similarity
#                                   (system_prompt vs model_output).
#                                   Empirique, tuné sur corpus PLeak
#                                   CCS'24 arXiv 2405.06823. Gardé
#                                   configurable parce qu'il n'y a
#                                   pas de one-size-fits-all sans
#                                   tuning par déploiement.
#
# Threat model coverage (HARDENING_ROADMAP §3 S21, D3):
#   - T3-PromptLeak : LLM echo system_prompt (PLeak reconstruction
#     attack) → détecté par cascade exact/substring/EED.
#   - T-OWASP-LLM-#7 : zero-width + PUA + Tag chars invisibles
#     cachés dans output → stripped.

[default]
enabled = true

[invisible_text]
strip_zero_width = true
strip_pua = true
strip_tag_chars = true
whitelist_cf = true

[prompt_echo]
exact_match = true
substring_match_min_len = 40
eed_threshold = 0.85
