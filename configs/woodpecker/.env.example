# Woodpecker CI environment variables.
# Copy to .env and fill in real values. NEVER commit .env itself.

# Public URL of the Woodpecker instance (with https://)
WOODPECKER_HOST=https://ci.example.com

# Domain for Caddy TLS (without https://)
WOODPECKER_DOMAIN=ci.example.com

# GitHub OAuth App credentials
# Create at: https://github.com/settings/applications/new
#   Application name: SBFB Woodpecker CI
#   Homepage URL: https://ci.example.com
#   Authorization callback URL: https://ci.example.com/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Admin username(s) — comma-separated GitHub usernames
WOODPECKER_ADMIN=SBFB50

# Agent secret — generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=
