# SBFB Warrant Canary — FROST DKG ceremony configuration.
#
# Copy this file to `<sbfb_home>/canary.toml` and fill in the
# paths. See `docs/security/WARRANT_CANARY_HARDENING.md §4` for
# the full ops runbook.
#
# Sprint 30 Phase C.

[frost]
# K-of-N threshold parameters (set during trusted-dealer DKG).
min_signers = 2
max_signers = 3

[frost.paths]
# Path to this participant's key share file.
# Generated by `sbfb canary frost trusted-dealer`.
share = "canary-share-1.frost.json"

# Path to the public key package (shared with all verifiers).
pubkey_package = "canary-pubkey-package.frost.json"

# Directory for ceremony intermediate files (commitments, nonces,
# signing packages, signature shares). Use a RAM-backed tmpfs or
# encrypted volume on the air-gapped machine.
ceremony_dir = "/tmp/frost-ceremony"
