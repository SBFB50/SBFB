{
  "name": "factory-operator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "size": "size-limit",
    "gate:no-radix": "bash scripts/check-no-radix-runtime.sh",
    "gate:no-tw-config": "bash scripts/check-no-tailwind-config.sh",
    "gate:scan-front": "bash scripts/scan-front-discipline.sh",
    "gate:i18n-verdict": "bash scripts/check-i18n-verdict-cross-locale.sh",
    "gate:i18n-parity": "bash scripts/check-i18n-key-parity.sh",
    "gates": "npm run gate:no-radix && npm run gate:no-tw-config && npm run gate:scan-front && npm run gate:i18n-verdict && npm run gate:i18n-parity"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@lingui/core": "^6.4.0",
    "@lingui/react": "^6.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "^9.39.4",
    "@lingui/babel-plugin-lingui-macro": "^6.4.0",
    "@lingui/cli": "^6.4.0",
    "@lingui/vite-plugin": "^6.4.0",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@size-limit/file": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "size-limit": "^12.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  }
}
