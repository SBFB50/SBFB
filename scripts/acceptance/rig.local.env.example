# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Rig config (DATA) for scripts/acceptance/b3_shard_pipeline.sh — the
# Sprint 77 Phase K sharded-inference T2 acceptance harness.
#
# Copy to `scripts/acceptance/rig.local.env` (GITIGNORED) and fill in.
# Explicit env vars on the command line still override these.
#
#   cp scripts/acceptance/rig.local.env.example scripts/acceptance/rig.local.env
#   $EDITOR scripts/acceptance/rig.local.env
#   bash scripts/acceptance/b3_shard_pipeline.sh

# Pipeline head — the RTX 5080 (CUDA) host's daemon loopback URL.
export PC_DAEMON=http://127.0.0.1:7777

# Second shard — the Mac M2 (Metal) machine, reachable over SSH. Sharding
# is meaningless on a single host: a ~20 GB model does not fit on the 5080
# alone, which is the point.
export MAC_SSH=user@mac-m2.local

# The project-doc id the PC daemon hosts (reconciled against
# GET /api/daemon/project-info — a mismatch is RIG-ABSENT).
export PROJECT_ID=

# The arch-llama model that fits on NEITHER machine alone. Since S81
# Phase J (real inference, PO Option B), point this at the GGUF FILE
# the serves load (GGUF-direct mode — the SAME file must exist on both
# machines); an Ollama model NAME still works for the tag-presence
# check only (e.g. mixtral:8x7b-instruct-v0.1-q3_K_M).
export MODEL_20GB=C:/Users/FlowUP/spike_fork/codellama-34b.gguf

# Path to the local nexus-worker binary (head side).
export WORKER_BIN=./target/release/nexus-worker

# The live shard-session id to drive. Since S81 Phase I the production
# orchestrator mounts one (`nexus-shell-daemon shard-session group` +
# `serve` on each worker + `mount`); since Phase J the serves host REAL
# layer blocks (`serve --model <gguf> --layer-start N --layer-end N`,
# built per machine with --features llm_llama_cpp_cuda / _metal —
# windows printed by `shard-session plan`). Set the mounted id here.
export SHARD_SESSION_ID=

# OPERATOR NOTE (review J8-4): the daemon-discovery stale-check matches
# the running pid by EXECUTABLE NAME (`nexus-shell-daemon`). If you run
# the head daemon from a copied binary, keep the file named EXACTLY
# `nexus-shell-daemon(.exe)` — a renamed copy reads as a dead pid and
# every shard-session CLI call bails with "daemon is not running".

# Optional tuning.
# export N_SHARDS=2
# export GATE_TIMEOUT_SECS=120
# export RTT_GATE_MS=80
# export OLLAMA_URL=http://127.0.0.1:11434
# export MAX_TOKENS=16   # bounded REAL decode (per-step recompute, Phase J)

# ---------------------------------------------------------------------------
# Sprint 82 Phase B — standard benchmarks (scripts/acceptance/benchmarks_standards.sh)
# ---------------------------------------------------------------------------
# llama-bench + perplexity are BUILD-TOOLS built SEPARATELY from an upstream
# llama.cpp checkout pinned to the same snapshot as the vendored shard backend
# (see docs/protocol/SHARD_BENCHMARKS.md §2 for the provenance chain). This is
# a rig-only build tool — 0 Cargo dep, CI never builds it.
# export LLAMA_BENCH_BIN=/path/to/upstream/llama.cpp/build/bin/llama-bench
# export PERPLEXITY_BIN=/path/to/upstream/llama.cpp/build/bin/perplexity
# export WIKITEXT2_PATH=/path/to/wikitext-2-raw/wiki.test.raw
# The ggml-org/llama.cpp sha resolved from utilityai/llama-cpp-rs@4afdaf0's
# llama.cpp submodule — graved into the artefact so a PPL parity compares the
# SAME kernels.
# export LLAMACPP_COMMIT=<resolved ggml-org sha>
# export QUANT=Q4_K_M
# Optional 2nd machine (Metal) single-machine baseline over SSH.
# export MAC_LLAMA_BENCH_BIN=/path/to/upstream/llama.cpp/build/bin/llama-bench
# export MAC_MODEL=/path/to/codellama-34b.gguf   # on the Mac
# Determinism knobs (pinned defaults; override only with a rationale).
# export BENCH_THREADS=8
# export BENCH_PP=512
# export BENCH_TG=128
# export BENCH_REPS=3
# export PPL_SEED=1234
# Reject a b3 sharded artefact older than this many minutes as stale (the
# sharded run must be from the current session for a PASS).
# export B3_MAX_AGE_MIN=120
