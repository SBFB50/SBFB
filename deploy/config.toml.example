# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Shell daemon configuration for VPS bootstrap nodes.
# Copy to $NEXUS_GRID_ROOT/shell-daemon/config.toml and adjust —
# /var/lib/nexus-grid/shell-daemon/config.toml under the shipped
# nexus-shell-daemon.service unit.

[logging]
level = "info"

[network]
# Loopback only — nginx proxies external traffic.
api_host = "127.0.0.1"
# Fixed port so nginx and coordinator can find the daemon.
# Use 0 for ephemeral (development).
api_port = 7000

[curator]
# Ed25519 public keys (hex) to auto-subscribe at first boot.
# Populated after first curator list creation on this VPS.
# Other VPS nodes set this to the primary curator's pubkey.
#
# Sprint 75 (Q3): a node-directory ANCHOR is subscribed here too —
# curator lists and node directories share ONE attention set, so
# putting an anchor's node pubkey in this list is what makes its
# signed catalog ingest + re-pull at boot. There is deliberately no
# separate [directory] section (one attention set, one subscribe).
default_curators = []

[seed]
# Sprint 75 Phase E: the headless boot seed driver's accept-list.
# Project ids (64-char hex, blake3 of the project name) this node
# acquires + pins + keeps online at boot — including apps it never
# deployed locally (resolved through the subscribed directories
# above + the best-effort seeder registry).
#
# EMPTY by default (anti-recentralization verrou 3): an anchor's
# seed set only ever comes from the operator's own config, never a
# shipped default. The accept-list IS the bound — seed only YOUR
# apps + accepted invites, never a universal mirror.
#
# First-boot note: the driver is one-shot. An app that only exists
# in a directory this node has not yet ingested is skipped this
# boot — trigger it live with POST /api/daemon/seed {"project_id"}
# once the directory arrives, or restart the daemon.
keep_online_projects = []

[mailbox]
# Chat v1 offline mailbox (ADR_CHAT_V1, decision 5).
#
# Client role — node ids (64 hex) this node MAY hand a READ ticket of
# a conversation to. Nothing is sent unless the user turned the mailbox
# on for that app. A fresh desktop install writes the public anchor
# here at first boot; the compiled default is empty.
servers = []
#
# Server role — keep read-only replicas for other nodes. Off by
# default; turn it on for an always-on anchor only. The server sees
# which nodes share a conversation and when, never the content.
serve = false
# Days a deposit is kept after its last refresh (clients refresh daily).
ttl_days = 21
# Worst-case disk for live documents = max_docs * max_doc_mib.
max_docs = 256
max_docs_per_node = 16
max_doc_mib = 16

[transport]
# What this node reveals of its network position. A desktop node keeps
# the compiled defaults (both false): the tickets and announcements it
# hands out name its relay and private addresses only, never its public
# IP, and it asks the home router to open nothing. An anchor on a VPS
# has a public address worth publishing: peers then dial it directly
# instead of going through the relay first.
advertise_ip = true
# UPnP / PCP / NAT-PMP port mapping. Pointless on a VPS (no NAT).
portmapper = false
