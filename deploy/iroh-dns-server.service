# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Self-hosted pkarr relay + DNS server for the SBFB zero-n0 mode
# (Sprint 81 Phase E2, PO decision C8). Replaces dns.iroh.link
# (n0, EOL 2026-09-30): SBFB nodes booted with SBFB_ZERO_N0=1
# publish (PUT) and resolve (GET) their addresses on this server's
# /pkarr endpoint. Ops runbook: docs/release/IROH_SELFHOST_OPS.md.
#
# Install:
#   useradd --system --home-dir /var/lib/iroh-dns-server --shell /usr/sbin/nologin iroh-dns
#   cargo install iroh-dns-server --version 1.0.1   # match the workspace pin
#   install -m 0755 ~/.cargo/bin/iroh-dns-server /usr/local/bin/
#   install -d -o iroh-dns -g iroh-dns -m 0700 /etc/iroh-dns-server
#   cp config.toml (runbook §4.2 template) /etc/iroh-dns-server/config.toml
#   cp iroh-dns-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now iroh-dns-server

[Unit]
Description=iroh-dns-server (SBFB zero-n0 self-hosted pkarr relay + DNS)
Documentation=https://github.com/sbfb/nexus-grid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iroh-dns
Group=iroh-dns
ExecStart=/usr/local/bin/iroh-dns-server --config /etc/iroh-dns-server/config.toml
Restart=on-failure
RestartSec=5

# Zone store + ACME certificates live under the StateDirectory;
# ProtectSystem=strict keeps everything else read-only.
StateDirectory=iroh-dns-server
StateDirectoryMode=0700

# Hardening: same canonical systemd.exec set as
# nexus-shell-daemon.service (S75 anchor), with ONE delta: the
# authoritative DNS listener binds :53 (< 1024), so the unit needs
# CAP_NET_BIND_SERVICE instead of an empty capability set. (The
# SBFB clients only need the HTTPS /pkarr endpoint — :8443 in the
# runbook template — but the DNS half serves DoH + a future
# DnsAddressLookup and stays enabled.)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
