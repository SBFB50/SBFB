+        // the last shard only. Defaults (0, 0, true, true) load the whole model (upstream
+        // behaviour, exactly).
+        int32_t shard_layer_start;
+        int32_t shard_layer_end;
+        bool    shard_is_first;
+        bool    shard_is_last;
