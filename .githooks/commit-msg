#!/usr/bin/env sh
set -eu

run_agentctl() {
  if command -v python3 >/dev/null 2>&1; then
    python3 scripts/agent/agentctl.py "$@"
  elif command -v python >/dev/null 2>&1; then
    python scripts/agent/agentctl.py "$@"
  elif command -v py >/dev/null 2>&1; then
    py -3 scripts/agent/agentctl.py "$@"
  else
    echo "[agentctl] BLOCK: no Python interpreter found" >&2
    exit 2
  fi
}

run_agentctl precommit-lightcheck --scope message --message-file "$1"
run_agentctl auditor-gate --message-file "$1"
