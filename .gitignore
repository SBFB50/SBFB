# === NEXUS .gitignore ===

# Data & databases (runtime state — never commit)
data/
*.db
*.db-wal
*.db-shm

# Exception: benchmark data is version-controlled (text only, no secrets)
!data/benchmark/

# Environment files (use .env.example as reference)
.env
.env.local
robin.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Python dev caches
.mypy_cache/
.ruff_cache/

# Test / CI artifacts
.coverage
htmlcov/
.deepeval/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node.js
web/node_modules/
web/.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code — process tooling partagé avec tous les contributeurs
# On commit le dossier .claude/ (settings.json, hooks, skills, agents,
# commands) pour que toute session nexus herite du meme process qualite.
# Seules les donnees personnelles sont exclues :
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/cache/
.claude/history.jsonl
.claude/todos/
.claude/sessions/
.claude/projects/
.claude/file-history/
.claude/shell-snapshots/
.claude/paste-cache/
.claude/chrome/
.claude/debug/
.claude/telemetry/
.claude/statsig/
.claude/stats-cache.json
.claude/mcp-needs-auth-cache.json
.claude/gsd-file-manifest.json
.claude/package.json
.claude/backups/
.claude/ide/
.claude/plans/
.claude/plugins/cache/
.claude/plugins/data/
.claude/plugins/install-counts-cache.json
.claude/plugins/installed_plugins.json
.claude/session-env/
.claude/tasks/

# Rust / Cargo (SBFB monorepo, Sprint 1+)
target/
**/*.rs.bk
Cargo.lock.bak
.cargo/

# Python build artifacts from maturin (nexus-core-py wheels)
crates/nexus-core-py/target/
wheels/

# uv
.uv/

# OS
Thumbs.db
.DS_Store

# Models (large GGUF files)
models/*.gguf

# Logs
logs/
*.log

# Sprint 2 audit shards — kept locally, not part of the repo
# (9 .md files reviewing Sprint 2 crate-by-crate, inert outside
# the cargo workspace).
.planning/audit_sprint2/
