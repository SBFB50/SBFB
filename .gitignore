# === NEXUS .gitignore ===

# Data & databases (runtime state — never commit)
data/
*.db
*.db-wal
*.db-shm

# Exception: benchmark data is version-controlled (text only, no secrets)
!data/benchmark/

# Exception: TDD Guard config (committed nexus process tooling)
!.claude/tdd-guard/data/
!.claude/tdd-guard/data/config.json

# Environment files (use .env.example as reference)
.env
.env.local
robin.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Python dev caches
.mypy_cache/
.ruff_cache/

# Test / CI artifacts
.coverage
htmlcov/
.deepeval/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node.js
web/node_modules/
web/.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code — on commit .claude/ pour partager le process (hooks,
# skills, agents, commands, settings.json) avec tous les contributeurs.
# Exclure uniquement les fichiers vraiment personnels ou runtime :
.claude/settings.local.json        # perms perso avec paths absolus
.claude/scheduled_tasks.lock       # lock runtime du scheduler
.claude/worktrees/                 # worktrees agents ephemeres
.claude/_autoinstall_signaled.marker  # marker SessionStart hook (local)

# Rust / Cargo (SBFB monorepo, Sprint 1+)
target/
**/*.rs.bk
Cargo.lock.bak
# Ignore per-user cargo state (credentials, local overrides) but keep
# the workspace-wide reproducibility config. Sprint 18 Phase B ships
# .cargo/config.toml with `CARGO_INCREMENTAL=0` + `/Brepro` on Windows.
.cargo/*
!.cargo/config.toml

# Python build artifacts from maturin (nexus-core-py wheels)
crates/nexus-core-py/target/
wheels/

# uv
.uv/

# OS
Thumbs.db
.DS_Store

# Models (large GGUF files)
models/*.gguf

# Logs
logs/
*.log

# Sprint 2 audit shards — kept locally, not part of the repo
# (9 .md files reviewing Sprint 2 crate-by-crate, inert outside
# the cargo workspace).
.planning/audit_sprint2/
