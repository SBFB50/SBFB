# === NEXUS .gitignore ===

# Data & databases (runtime state — never commit)
data/
*.db
*.db-wal
*.db-shm

# Exception: benchmark data is version-controlled (text only, no secrets)
!data/benchmark/

# Exception: TDD Guard config (committed nexus process tooling)
!.claude/tdd-guard/data/
!.claude/tdd-guard/data/config.json

# Environment files (use .env.example as reference)
.env
.env.local
robin.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Python dev caches
.mypy_cache/
.ruff_cache/

# Test / CI artifacts
.coverage
htmlcov/
.deepeval/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node.js
web/node_modules/
web/.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code — on commit .claude/ pour partager le process (hooks,
# skills, agents, commands, settings.json) avec tous les contributeurs.
# Exclure uniquement les fichiers vraiment personnels ou runtime :
# perms perso avec paths absolus
.claude/settings.local.json
# lock runtime du scheduler
.claude/scheduled_tasks.lock
# lock runtime du narrateur (mutex Haiku subprocess, cf. 3c18908)
.claude/narrate-action.lock
# worktrees agents ephemeres
.claude/worktrees/
# marker SessionStart hook (local)
.claude/_autoinstall_signaled.marker
# runtime heartbeat viewer narration (refresh 1s)
.claude/.narration-terminal.heartbeat
# runtime heartbeat sidecar input terminal (refresh 5s)
.claude/.sidecar-terminal.heartbeat
# queue de questions sidecar drainee par PostToolUse hook
.claude/.sidecar-queue.jsonl
# replies log (delivery confirmations + optional Claude acks) drained
# by sidecar-input.js tail — ephemere session
.claude/.sidecar-replies.jsonl

# Rust / Cargo (SBFB monorepo, Sprint 1+)
target/
**/*.rs.bk
Cargo.lock.bak
# Ignore per-user cargo state (credentials, local overrides) but keep
# the workspace-wide reproducibility config. Sprint 18 Phase B ships
# .cargo/config.toml with `CARGO_INCREMENTAL=0` + `/Brepro` on Windows.
.cargo/*
!.cargo/config.toml

# Python build artifacts from maturin (nexus-core-py wheels)
crates/nexus-core-py/target/
wheels/

# uv
.uv/

# OS
Thumbs.db
.DS_Store

# Models (large GGUF files)
models/*.gguf

# Logs
logs/
*.log
# Exception: phase-auditor bypass audit trail must be committed
# (Sprint 22 Phase F — P2-S21-5 fix). Entries appended when
# NEXUS_SKIP_PHASE_AUDITOR=1 is used.
!.claude/.bypass_audit_trail.log

# Sprint 2 audit shards — kept locally, not part of the repo
# (9 .md files reviewing Sprint 2 crate-by-crate, inert outside
# the cargo workspace).
.planning/audit_sprint2/

# === Sprint 20 open — P2-2 NOISE coverage (audit S19 finding) ===
# Untracked root files documented as pre-launch hors-scope dans
# sprint19_audit_findings.md §Track F + Phase F commit body. These
# are local dev artefacts + docs drafts pour lesquels un sprint
# dedie docs apps integrera le classement propre plus tard.

# Local dev binary artefacts
test_libc.exe
test_libc.pdb

# Local dev JSON + build outputs (not related to repo packages)
/cc.json
/site/
/node_modules/
/test-results/

# In-progress app design docs (pre-sprint intake, not planning)
docs/DND_P2P_DESIGN.md
docs/VISION_USE_CASES.md
docs/apps/
