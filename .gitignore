# === NEXUS .gitignore ===

# Data & databases (runtime state — never commit)
data/
*.db
*.db-wal
*.db-shm

# Exception: benchmark data is version-controlled (text only, no secrets)
!data/benchmark/

# Environment files (use .env.example as reference)
.env
.env.local
robin.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Python dev caches
.mypy_cache/
.ruff_cache/

# Test / CI artifacts
.coverage
htmlcov/
.deepeval/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node.js
web/node_modules/
web/.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code local settings
.claude/

# OS
Thumbs.db
.DS_Store

# Models (large GGUF files)
models/*.gguf

# Logs
logs/
*.log
